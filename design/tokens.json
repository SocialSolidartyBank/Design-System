{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "함세상 디자인 시스템 v5. 변경: H1~H4 semantic 네이밍 · 한글 H1 64 H2 56 H3 40 H4 32 · 영문 H1 80(w700) H2 64 H3 40 H4 36 · body 18 · caption 16 · Satoshi · sky-blue-light · image-placeholder.",

  "color": {
    "$type": "color",

    "primary":          { "$value": "#006CB7", "$description": "CTA · 타이틀 · 섹션 bg." },
    "primary-active":   { "$value": "#338BC9" },

    "dark-blue":        { "$value": "#26257C" },
    "dark-blue-active": { "$value": "#3D3CA0" },

    "ink-deep":         { "$value": "#0A1E33" },
    "ink":              { "$value": "#1A1B1F" },

    "canvas":           { "$value": "#FFFFFF" },
    "light-grey":       { "$value": "#ECF0F3" },

    "body":             { "$value": "#454745" },
    "grey":             { "$value": "#7B7875" },

    "sky-blue":         { "$value": "#58C5FF", "$description": "accent text · primary bg 위 강조." },
    "sky-blue-light":   { "$value": "#CDEAFF", "$description": "신설. sky-blue를 white 쪽으로 65% 옅게. primary bg 위 sub-text 색." },

    "on-primary":       { "$value": "#FFFFFF" },
    "on-dark-blue":     { "$value": "#FFFFFF" },
    "on-ink":           { "$value": "#FFFFFF" },
    "on-sky-blue":      { "$value": "#0A1E33", "$description": "sky-blue 버튼 위 텍스트 — 흰색은 가독성 부족." },

    "positive":         { "$value": "#00A775" },
    "warning":          { "$value": "#FAA41A" },
    "negative":         { "$value": "#F16A26" }
  },

  "section": {
    "$type": "other",
    "$description": "5종 섹션 배경. sky-blue 섹션 bg 없음.",
    "bg-default":   { "$value": "{color.canvas}" },
    "bg-soft":      { "$value": "{color.light-grey}" },
    "bg-primary":   { "$value": "{color.primary}" },
    "bg-dark-blue": { "$value": "{color.dark-blue}" },
    "bg-ink":       { "$value": "{color.ink-deep}" }
  },

  "fontFamily": {
    "$type": "fontFamily",
    "$description": "Pretendard (한글) + Satoshi (영문/숫자, Fontshare). General Sans 폐기.",
    "kr": { "$value": ["Pretendard Variable", "Pretendard", "system-ui", "Apple SD Gothic Neo", "Noto Sans KR", "sans-serif"] },
    "en": { "$value": ["Satoshi", "Pretendard Variable", "sans-serif"] }
  },

  "fontWeight": {
    "$type": "fontWeight",
    "regular":   { "$value": 400 },
    "medium":    { "$value": 500 },
    "semibold":  { "$value": 600 },
    "bold":      { "$value": 700 },
    "extrabold": { "$value": 800 }
  },

  "typography": {
    "$type": "typography",
    "$description": "H1~H4 semantic. 한글 사이즈 — H1 64 / H2 56 / H3 40 / H4 32 · body 18 · caption 16.",

    "h1":          { "$value": { "fontFamily": "{fontFamily.kr}", "fontSize": "64px", "fontWeight": "{fontWeight.extrabold}", "lineHeight": "115%", "letterSpacing": "-0.02em" }, "$description": "Hero · 한글 자간 -5%." },
    "h2":          { "$value": { "fontFamily": "{fontFamily.kr}", "fontSize": "56px", "fontWeight": "{fontWeight.bold}",      "lineHeight": "118%", "letterSpacing": "-0.02em" } },
    "h3":          { "$value": { "fontFamily": "{fontFamily.kr}", "fontSize": "40px", "fontWeight": "{fontWeight.bold}",      "lineHeight": "125%", "letterSpacing": "-0.02em" } },
    "h4":          { "$value": { "fontFamily": "{fontFamily.kr}", "fontSize": "27px", "fontWeight": "{fontWeight.bold}",      "lineHeight": "135%", "letterSpacing": "-0.02em" } },

    "body":        { "$value": { "fontFamily": "{fontFamily.kr}", "fontSize": "18px", "fontWeight": "{fontWeight.regular}",   "lineHeight": "170%", "letterSpacing": "-0.02em" }, "$description": "본문 통일 · 자간 -5%." },
    "body-strong": { "$value": { "fontFamily": "{fontFamily.kr}", "fontSize": "18px", "fontWeight": "{fontWeight.semibold}",  "lineHeight": "170%", "letterSpacing": "-0.02em" } },
    "caption":     { "$value": { "fontFamily": "{fontFamily.kr}", "fontSize": "16px", "fontWeight": "{fontWeight.regular}",   "lineHeight": "160%", "letterSpacing": "-0.02em" }, "$description": "최소 사이즈." },

    "button":      { "$value": { "fontFamily": "{fontFamily.kr}", "fontSize": "16px", "fontWeight": "{fontWeight.semibold}",  "lineHeight": "150%", "letterSpacing": "-0.02em" } }
  },

  "typographyEn": {
    "$type": "typography",
    "$description": ":lang(en) 분기 · Satoshi. body 20 · caption 15.",
    "h1":          { "$value": { "fontFamily": "{fontFamily.en}", "fontSize": "80px", "fontWeight": "{fontWeight.bold}",      "lineHeight": "108%", "letterSpacing": "-0.03em" } },
    "h2":          { "$value": { "fontFamily": "{fontFamily.en}", "fontSize": "64px", "fontWeight": "{fontWeight.bold}",      "lineHeight": "110%", "letterSpacing": "-0.025em" } },
    "h3":          { "$value": { "fontFamily": "{fontFamily.en}", "fontSize": "40px", "fontWeight": "{fontWeight.bold}",      "lineHeight": "120%", "letterSpacing": "-0.015em" } },
    "h4":          { "$value": { "fontFamily": "{fontFamily.en}", "fontSize": "30px", "fontWeight": "{fontWeight.semibold}",  "lineHeight": "130%", "letterSpacing": "-0.01em" } },
    "body":        { "$value": { "fontFamily": "{fontFamily.en}", "fontSize": "20px", "fontWeight": "{fontWeight.regular}",   "lineHeight": "160%", "letterSpacing": "0" }, "$description": "영문 본문 20 (한글 18보다 큼)." },
    "body-strong": { "$value": { "fontFamily": "{fontFamily.en}", "fontSize": "20px", "fontWeight": "{fontWeight.semibold}",  "lineHeight": "160%", "letterSpacing": "0" } },
    "caption":     { "$value": { "fontFamily": "{fontFamily.en}", "fontSize": "15px", "fontWeight": "{fontWeight.regular}",   "lineHeight": "155%", "letterSpacing": "0" } }
  },

  "spacing": {
    "$type": "dimension",
    "$description": "WISE-style 여백. 6xl 128 신설.",
    "xs":  { "$value": "4px" },  "sm":  { "$value": "8px" },  "md":  { "$value": "12px" },
    "lg":  { "$value": "16px" }, "xl":  { "$value": "24px" }, "2xl": { "$value": "32px" },
    "3xl": { "$value": "48px" }, "4xl": { "$value": "64px" }, "5xl": { "$value": "96px" },
    "6xl": { "$value": "128px" },"7xl": { "$value": "160px" }
  },

  "radius": {
    "$type": "dimension",
    "md":   { "$value": "12px" },
    "lg":   { "$value": "16px" },
    "xl":   { "$value": "24px" },
    "2xl":  { "$value": "32px", "$description": "이미지 placeholder · 큰 카드." },
    "pill": { "$value": "9999px" }
  },

  "elevation": {
    "$type": "shadow",
    "$description": "hero apply-card 전용 그림자.",
    "none":      { "$value": "none" },
    "card-hero": { "$value": "0 4px 16px rgba(10, 30, 51, 0.06), 0 16px 48px rgba(10, 30, 51, 0.08)", "$description": "light-grey 위 흰 hero 카드용. 부드럽고 깊이감." },
    "card-soft": { "$value": "0 2px 8px rgba(10, 30, 51, 0.04)" }
  },

  "breakpoint": {
    "$type": "dimension",
    "tablet":  { "$value": "768px" },
    "desktop": { "$value": "1024px" }
  },

  "component": {
    "$description": "4 버튼 · 5 카드 · apply-card · step-circle · text-input · image-placeholder · footer.",

    "button-primary": {
      "background": { "$value": "{color.primary}" },
      "text":       { "$value": "{color.on-primary}" },
      "padding":    { "$value": "{spacing.md} {spacing.xl}" },
      "radius":     { "$value": "{radius.xl}" }
    },
    "button-dark": {
      "background": { "$value": "{color.dark-blue}" },
      "text":       { "$value": "{color.on-dark-blue}" },
      "padding":    { "$value": "{spacing.md} {spacing.xl}" },
      "radius":     { "$value": "{radius.xl}" }
    },
    "button-sky": {
      "$description": "신설. 타이틀이 primary일 때 dark-blue와 함께 쓰는 옵션.",
      "background": { "$value": "{color.sky-blue}" },
      "text":       { "$value": "{color.on-sky-blue}" },
      "padding":    { "$value": "{spacing.md} {spacing.xl}" },
      "radius":     { "$value": "{radius.xl}" }
    },
    "button-white": {
      "background": { "$value": "{color.canvas}" },
      "text":       { "$value": "{color.primary}" },
      "padding":    { "$value": "{spacing.md} {spacing.xl}" },
      "radius":     { "$value": "{radius.xl}" }
    },

    "card-default":   { "background": { "$value": "{color.canvas}" },    "text": { "$value": "{color.ink}" },      "padding": { "$value": "{spacing.2xl}" }, "radius": { "$value": "{radius.xl}" } },
    "card-soft":      { "background": { "$value": "{color.light-grey}" },"text": { "$value": "{color.ink}" },      "padding": { "$value": "{spacing.2xl}" }, "radius": { "$value": "{radius.xl}" } },
    "card-primary":   { "background": { "$value": "{color.primary}" },   "text": { "$value": "{color.on-primary}" },"padding": { "$value": "{spacing.2xl}" }, "radius": { "$value": "{radius.xl}" } },
    "card-dark-blue": { "background": { "$value": "{color.dark-blue}" }, "text": { "$value": "{color.on-dark-blue}" }, "padding": { "$value": "{spacing.2xl}" }, "radius": { "$value": "{radius.xl}" } },
    "card-ink":       { "background": { "$value": "{color.ink-deep}" },  "text": { "$value": "{color.on-ink}" },   "padding": { "$value": "{spacing.2xl}" }, "radius": { "$value": "{radius.xl}" } },

    "apply-card": {
      "$description": "hero 카드. light-grey 섹션 위 흰 카드 + 그림자 + primary 버튼.",
      "background": { "$value": "{color.canvas}" },
      "text":       { "$value": "{color.ink}" },
      "padding":    { "$value": "{spacing.3xl}" },
      "radius":     { "$value": "{radius.xl}" },
      "shadow":     { "$value": "{elevation.card-hero}" }
    },

    "step-circle": {
      "background": { "$value": "{color.primary}" },
      "text":       { "$value": "{color.on-primary}" },
      "size":       { "$value": "32px" },
      "fontFamily": { "$value": "{fontFamily.en}" },
      "fontSize":   { "$value": "14px" },
      "fontWeight": { "$value": "{fontWeight.semibold}" },
      "radius":     { "$value": "{radius.pill}" }
    },

    "text-input": {
      "$description": "테두리 없음. light-grey 배경.",
      "background": { "$value": "{color.light-grey}" },
      "text":       { "$value": "{color.ink}" },
      "padding":    { "$value": "{spacing.lg} {spacing.xl}" },
      "radius":     { "$value": "{radius.md}" }
    },

    "image-placeholder": {
      "$description": "이미지 자리. 컬러 라운드박스. 4 변형 (sky/primary/dark/soft).",
      "radius":      { "$value": "{radius.2xl}" },
      "aspect-16-9": { "$value": "16 / 9" },
      "aspect-4-3":  { "$value": "4 / 3" },
      "aspect-1-1":  { "$value": "1 / 1" }
    },

    "footer": {
      "background": { "$value": "{color.ink-deep}" },
      "text":       { "$value": "{color.light-grey}" },
      "padding":    { "$value": "{spacing.5xl} {spacing.xl}" },
      "typography": { "$value": "{typography.caption}" }
    }
  },

  "textColorByBg": {
    "$description": "섹션별 텍스트 컬러 + 버튼 룰.",
    "on-white":     { "title": "primary",   "subtitle": "ink-deep",        "body": "ink",            "secondary": "grey",            "emphasis": "primary",  "buttons": ["dark", "sky"] },
    "on-soft":      { "title": "primary",   "subtitle": "ink-deep",        "body": "ink",            "secondary": "grey",            "emphasis": "primary",  "buttons": ["dark", "sky"] },
    "on-primary":   { "title": "canvas",    "subtitle": "sky-blue-light",  "body": "canvas",         "secondary": "sky-blue-light",  "emphasis": "sky-blue", "buttons": ["white", "dark"] },
    "on-dark-blue": { "title": "canvas",    "subtitle": "canvas",          "body": "canvas",         "secondary": "light-grey",      "emphasis": "sky-blue", "buttons": ["white", "primary"] },
    "on-ink":       { "title": "canvas",    "subtitle": "canvas",          "body": "light-grey",     "secondary": "grey",            "emphasis": "sky-blue", "buttons": ["white", "primary"] }
  },

  "rules": {
    "$description": "디자인 룰.",
    "title-button-pairing": "title이 primary면 버튼은 sky-blue 또는 dark-blue (primary 중복 금지)",
    "hero-spec":            "hero 카드 섹션은 light-grey bg + 흰 카드 + card-hero 그림자 + primary 제출 버튼",
    "no-sky-section":       "sky-blue는 accent text/icon 한정 — 섹션 배경 금지"
  }
}
